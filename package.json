{
  "name": "spark-dapp",
  "version": "2.1.0-cachefix",
  "description": "SPARK 星火通证 - AI 驱动的去中心化应用 (DApp)，部署于 GitHub Pages + IPFS",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:now": "python3 scripts/deploy-now.py",
    "deploy:cachefix": "python3 scripts/deploy-cachefix.py",
    "lint": "node scripts/lint.mjs",
    "verify": "node scripts/verify.mjs",
    "e2e": "node scripts/e2e.mjs",
    "dom": "node scripts/dom-smoke.mjs",
    "selfcheck": "python3 scripts/selfcheck.py",
    "all": "npm run lint && npm run verify && npm run selfcheck && npm run build && npm run dom"
  },
  "keywords": ["SPARK", "DApp", "Web3", "Ethereum", "IPFS"],
  "license": "MIT",
  "dependencies": {
    "jsdom": "^29.1.1"
  }
}
